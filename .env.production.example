# Telegram
BOT_TOKEN=replace_with_bot_token
TELEGRAM_BOT_USERNAME=replace_without_at_sign
ADMIN_IDS=123456789
MINI_APP_URL=https://f1hub.ru

# Web/auth
PUBLIC_WEB_URL=https://f1hub.ru
WEB_ORIGINS=https://f1hub.ru,https://www.f1hub.ru
AUTH_PEPPER=replace_with_at_least_32_random_characters
AUTH_COOKIE_SECURE=true
DATABASE_PATH=/app/data/bot.db

# Yandex Cloud Postbox via SMTP (recommended on Ubuntu)
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USERNAME=replace_with_postbox_api_key_id
SMTP_PASSWORD=replace_with_postbox_api_key_secret
SMTP_FROM_EMAIL=auth@f1hub.ru
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20

# Alternative for networks that block SMTP: static service-account access key
# EMAIL_DELIVERY_MODE=yandex_postbox_api
# YANDEX_POSTBOX_ACCESS_KEY_ID=replace_with_static_access_key_id
# YANDEX_POSTBOX_SECRET_ACCESS_KEY=replace_with_static_access_key_secret

# Compose overrides
APP_VERSION=latest
HTTP_PORT=80
HTTPS_PORT=443
SSL_DIR=./ssl
