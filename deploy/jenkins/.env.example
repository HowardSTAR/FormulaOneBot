# Группа сокета определяется автоматически скриптом scripts/start-jenkins.sh:
# stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Абсолютный путь на Ubuntu/Debian. Jenkinsfile переводит внутренний WORKSPACE
# в этот host path перед bind-mount в контейнеры Python и Node.js.
JENKINS_HOME_HOST=/srv/f1hub-jenkins/home

# Порт слушает только 127.0.0.1. Публичный доступ идёт через Nginx на 80/443.
JENKINS_HTTP_PORT=8080

JENKINS_CPUS=2.0
JENKINS_MEMORY=3g
JENKINS_MEMORY_RESERVATION=1g
