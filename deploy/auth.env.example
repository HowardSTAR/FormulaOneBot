# Merge into the private environment shared by web and bot. Never commit real secrets.
APP_ENV=production
AUTH_COOKIE_SECURE=true
# Required: generate a separate random secret, e.g. secrets.token_urlsafe(48).
AUTH_PEPPER=
PUBLIC_WEB_URL=https://f1hub.ru
WEB_ORIGINS=https://f1hub.ru,https://www.f1hub.ru
EMAIL_DELIVERY_MODE=smtp
SMTP_USE_SSL=false
SMTP_STARTTLS=true
# Keep existing SMTP credentials in the private environment/secret storage.
