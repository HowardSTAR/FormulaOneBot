# Добавить на сервере TurboTears в .env после создания проекта PostHog.
# Оставленные пустыми параметры сохраняют встроенную аналитику без внешней отправки.
POSTHOG_HOST=
POSTHOG_PROJECT_KEY=
# Пример адреса: https://analytics.your-domain.example
# Нужен Project API key из настроек проекта, а не Personal API key.
